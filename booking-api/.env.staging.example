APP_NAME="Peminjaman Ruang Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://apps-fsm.undip.ac.id/peminjaman-ruang-api-staging
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=peminjaman_ruang_staging
DB_USERNAME=peminjaman_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=peminjaman_ruang_staging_session
SESSION_PATH=/peminjaman-ruang-api-staging
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DRIVER=local
AWS_BUCKET=

FRONTEND_URL=https://apps-fsm.undip.ac.id
FRONTEND_APP_URL=https://apps-fsm.undip.ac.id/peminjaman-ruang-staging
SANCTUM_STATEFUL_DOMAINS=apps-fsm.undip.ac.id

SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_API_URL=https://apps-fsm.undip.ac.id/sso_api
SSO_LOGIN_URL=https://apps-fsm.undip.ac.id/sso/
SSO_REDIRECT_URI=

AUTH_LOCAL_LOGIN=off
AUTH_DEV_LOGIN=false
